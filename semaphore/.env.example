# Semaphore UI - Environment Template
# Copy to .env and fill in actual values. Never commit .env!
# chmod 600 .env

# Database
SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASS=CHANGE_ME_STRONG_PASSWORD
SEMAPHORE_DB_NAME=semaphore
SEMAPHORE_DB_HOST=db

# Access / Crypto Key (generate: openssl rand -hex 32)
SEMAPHORE_ACCESS_KEY=CHANGE_ME_HEX64

# Admin credentials (initial setup)
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=CHANGE_ME_PASSWORD
SEMAPHORE_ADMIN_NAME=Administrator
SEMAPHORE_ADMIN_EMAIL=admin@example.local

# Network binding
SEMAPHORE_BIND_HOST=10.10.0.2
SEMAPHORE_BIND_PORT=3000
